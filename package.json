{
	"name": "acme-dns-01-cloudflare",
	"version": "0.0.0-semantically-released",
	"description": "Cloudflare DNS for Let's Encrypt / ACME dns-01 challenges with Greenlock.js and ACME.js",
	"keywords": [
		"acme",
		"cloudflare",
		"dns",
		"dns-01",
		"greenlock",
		"letsencrypt"
	],
	"homepage": "https://github.com/nodecraft/acme-dns-01-cloudflare#readme",
	"bugs": {
		"url": "https://github.com/nodecraft/acme-dns-01-cloudflare/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nodecraft/acme-dns-01-cloudflare.git"
	},
	"license": "MIT",
	"author": "Nodecraft, Inc.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepack": "npm run build",
		"pretest": "npm run build",
		"test": "vitest run",
		"test:coverage": "npm run build && vitest run --coverage --coverage.include=src",
		"test:live": "npm run build && node tests/live.cjs",
		"typecheck": "tsc"
	},
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"dependencies": {
		"cloudflare": "^7.3.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@nodecraft/eslint-config": "^54.0.0",
		"@stylistic/eslint-plugin": "^6.0.0",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"@vitest/eslint-plugin": "^1.6.28",
		"acme-dns-01-test": "^3.3.2",
		"eslint": "^10.15.0",
		"eslint-plugin-import-newlines": "^2.0.0",
		"eslint-plugin-import-x": "^4.18.1",
		"eslint-plugin-n": "^18.5.0",
		"eslint-plugin-regexp": "^3.3.3",
		"eslint-plugin-unicorn": "^79.0.0",
		"publint": "^0.3.25",
		"semantic-release": "^25.0.9",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	}
}
